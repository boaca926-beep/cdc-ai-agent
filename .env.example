# ─────────────────────────────────────────────────────────────
# Environment template for ai-agent-context-pipeline
#
# Copy this file to .env and fill in real values:
#     cp .env.example .env
#
# .env is gitignored and never committed.
# .env.example is committed as the source of truth for what
# variables the project expects.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL (source system) ───────────────────────────────
# Host: use "postgres-source" inside docker compose,
#       "localhost" when running scripts from the host.
POSTGRES_HOST=postgres-source
POSTGRES_PORT=5432
POSTGRES_USER=insurance_user
POSTGRES_PASSWORD=insurance_pw
POSTGRES_DB=insurance_db

# ── Ollama (local LLM) ───────────────────────────────────────
# Host: use "ollama" inside docker compose,
#       "localhost" when calling from the host.
# No API key: local Ollama has no authentication.
OLLAMA_HOST=http://ollama:11434
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3:8b

# ── FastAPI / Uvicorn (Bronze API) ───────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info

# ── Delta Lake data roots ────────────────────────────────────
# Relative to the project root. Mounted into the api container
# via docker-compose.override.yml.
BRONZE_ROOT=./data/bronze_test
SILVER_ROOT=./data/silver
GOLD_ROOT=./data/gold
QUARANTINE_ROOT=./data/quarantine

# ── Optional: hosted LLM (only if you swap Ollama for a cloud provider) ──
# Leave commented out for local Ollama.
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Optional: Azure Container Apps deployment ────────────────
# Leave commented out for local dev.
# AZURE_RESOURCE_GROUP=rg-cdc-demo
# AZURE_LOCATION=swedencentral
# AZURE_CONTAINERAPP_NAME=bronze-api
